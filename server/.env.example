# =======================================================
# Cravo Server - Environment Configuration Example
# =======================================================

PORT=5000
NODE_ENV=production

# MySQL Database Configuration
DB_HOST=your-mysql-host.provider.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_secure_db_password
DB_NAME=cravo_db

# JWT Authentication Secret (MUST be a strong, unpredictable random string)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_64_character_hex_secret_in_production

# Frontend Client URL(s) allowed for CORS (comma-separated if multiple)
# Example: CLIENT_URL=https://cravo.vercel.app,https://admin.cravo.com
CLIENT_URL=http://localhost:5173
